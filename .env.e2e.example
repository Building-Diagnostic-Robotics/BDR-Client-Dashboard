# Copy to .env.e2e.local. Use dedicated DEVELOPMENT clients with permanent passwords.
# Use your local dashboard connected to the development BFF, or a development site.
PORTAL_E2E_ENVIRONMENT=development
PORTAL_E2E_BASE_URL=http://localhost:3000
PORTAL_E2E_AUTH_ORIGIN=https://YOUR-DEV-CLIENT-DOMAIN.auth.us-east-1.amazoncognito.com
PORTAL_E2E_CLIENT_EMAIL=
PORTAL_E2E_CLIENT_PASSWORD=
PORTAL_E2E_OTHER_EMAIL=
PORTAL_E2E_OTHER_PASSWORD=
